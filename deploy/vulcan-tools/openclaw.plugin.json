{
  "id": "vulcan-tools",
  "name": "Vulcan Tools",
  "description": "Proxies Vulcan LuaSkills tools into OpenClaw through vulcan-host.",
  "contracts": {
    "tools": [
      "vulcan_luaskill_call",
      "vulcan-codekit-ast-detail",
      "vulcan-codekit-ast-tree",
      "vulcan-codekit-markdown-menu",
      "vulcan-codekit-node-source",
      "vulcan-codekit-patch",
      "vulcan-codekit-rg",
      "vulcan-curl-get",
      "vulcan-curl-post",
      "vulcan-curl-request",
      "vulcan-file-edit",
      "vulcan-file-list",
      "vulcan-file-read",
      "vulcan-lua-run",
      "vulcan-testkit-run",
      "vulcan-workmem-delete",
      "vulcan-workmem-get",
      "vulcan-workmem-get-all",
      "vulcan-workmem-list",
      "vulcan-workmem-set",
      "vulcan-workmem-task-close",
      "vulcan-workmem-task-create",
      "vulcan-workmem-task-list"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "endpoint": {
        "type": "string",
        "description": "vulcan-host gRPC endpoint, for example 127.0.0.1:19202."
      },
      "protoPath": {
        "type": "string",
        "description": "Optional override for the bundled mcp_service.proto; a compatible vmm.proto must be in the same directory."
      },
      "enabled": {
        "type": "boolean",
        "description": "Whether this plugin should expose Vulcan tools."
      },
      "tools": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
